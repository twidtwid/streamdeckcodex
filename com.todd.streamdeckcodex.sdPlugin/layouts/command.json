{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "com.todd.streamdeckcodex.command",
  "items": [
    {
      "type": "text",
      "key": "title",
      "rect": [16, 10, 136, 24],
      "alignment": "left",
      "font": { "size": 16, "weight": 600 },
      "text-overflow": "clip"
    },
    {
      "type": "text",
      "key": "value",
      "rect": [8, 36, 184, 36],
      "alignment": "center",
      "color": "#FFFFFF",
      "font": { "size": 20, "weight": 750 },
      "text-overflow": "fade"
    },
    {
      "type": "bar",
      "key": "indicator",
      "rect": [18, 79, 164, 12],
      "bar_bg_c": "#2B313B",
      "bar_fill_c": "#2F81F7",
      "border_w": 0,
      "range": { "min": 0, "max": 100 },
      "subtype": 0,
      "value": 0
    }
  ]
}
